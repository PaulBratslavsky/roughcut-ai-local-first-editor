{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoughCut",
  "version": "0.1.0",
  "identifier": "dev.localfirst.roughcut",
  "build": {
    "beforeDevCommand": "cd ../frontend 2>/dev/null || cd ../../frontend; npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend 2>/dev/null || cd ../../frontend; npm run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RoughCut",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}