<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for signed builds (bundle.macOS.entitlements).
  Developer ID / notarized releases sign with hardened runtime, which blocks
  the camera and microphone unless the app declares these. That covers the
  WKWebView preview and the ffmpeg capture child, whose TCC requests are
  attributed to RoughCut. Screen Recording has no entitlement; it's a TCC grant only.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
